# Copy this file's contents into Vercel's dashboard under
# Project Settings -> Environment Variables. Never commit a real .env file.

# From Xendit dashboard -> Settings -> API Keys.
# Use the "Test" key while your business verification is pending,
# switch to the "Live" key once Xendit approves your account.
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx

# From Xendit dashboard -> Settings -> Webhooks -> Verification Token.
# This proves a "payment confirmed" call really came from Xendit.
XENDIT_CALLBACK_TOKEN=paste-the-token-shown-in-your-xendit-dashboard

# Your live site URL once deployed, e.g. https://viterglow.com
# Used to build the redirect links Xendit sends customers back to.
SITE_URL=https://your-domain-here.com

# Optional, see ORDER_STORAGE.md — a URL that receives a copy of every
# paid order (e.g. a Google Apps Script that appends a row to a Sheet).
# Leave blank to start; orders will just appear in Vercel's function logs.
ORDER_WEBHOOK_URL=
